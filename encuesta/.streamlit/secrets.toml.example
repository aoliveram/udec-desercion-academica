# Copiar a secrets.toml (que está en .gitignore) en el computador que
# aplica la encuesta. Ninguno de estos valores se sube a git.

# Carpeta con las nóminas reales (<nomina>.csv). Por defecto, data/nominas/.
# Debe estar fuera de cualquier repositorio git: contiene nombres reales.
directorio_nominas = "/ruta/fuera/del/repo/nominas"

# Sal para el hash de las IP (límite de tasa). Si se omite, se genera una en
# data/.ip_pepper la primera vez. Para crearla:
#   python -c "import secrets; print(secrets.token_hex(32))"
ip_hash_pepper = "reemplazar-por-un-valor-aleatorio-largo"

# Clave de seudonimización para scripts/exportar.py. La custodia el
# profesor/a responsable y se comparte solo por un canal seguro (Signal, un
# gestor de contraseñas), nunca por correo ni Drive. Usar siempre la misma:
# con otra clave, los ids de la misma persona cambian entre exportaciones.
clave_seudonimos = "reemplazar-por-la-clave-del-equipo"
